{
  "name": "@turkorbit/api",
  "version": "0.1.0",
  "private": true,
  "description": "Türk Orbit REST API (hesap, profil, ekonomi, yönetim). Gerçek zamanlı oyun sunucusu apps/game-server altındadır.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "grant-role": "tsx --env-file-if-exists=../../.env src/scripts/role-cli.ts grant",
    "revoke-role": "tsx --env-file-if-exists=../../.env src/scripts/role-cli.ts revoke",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@turkorbit/shared": "0.1.0",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "ioredis": "^5.6.1",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1"
  }
}
