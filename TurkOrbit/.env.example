# =====================================================================
# TÜRK ORBIT — örnek ortam değişkenleri
# Bu dosyayı ".env" adıyla kopyala:  cp .env.example .env
# .env dosyası GİZLİDİR, git'e eklenmez.
# =====================================================================

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# PostgreSQL 16 bağlantısı (docker-compose.yml ile aynı bilgiler)
DATABASE_URL=postgres://turkorbit:turkorbit_dev@127.0.0.1:5432/turkorbit
DATABASE_POOL_MAX=20

# Redis 7 (hız sınırlama + oturum önbelleği). Üretimde ZORUNLU.
REDIS_URL=redis://127.0.0.1:6379/0

# E-postalardaki bağlantıların açılacağı istemci adresi
PUBLIC_WEB_URL=http://localhost:5173
# İzinli Origin listesi (virgülle). Mobil uygulama için capacitor://localhost ve https://localhost eklenecek.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175
# nginx arkasında gerçek IP için: TRUST_PROXY=127.0.0.1
TRUST_PROXY=false

# Oturum ayarları
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7
# HTTPS kullanılan her ortamda true olmalı (üretimde varsayılan true)
COOKIE_SECURE=false
# Üretimde ZORUNLU, en az 32 karakter rastgele değer:  openssl rand -base64 48
CSRF_SECRET=

# Argon2id maliyeti (OWASP önerisinin üstünde: 64 MiB, 3 tur)
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# E-posta: smtp | console (yalnızca geliştirme; bağlantıları terminale yazar)
MAIL_TRANSPORT=console
# Örnek (Mailpit, docker-compose ile gelir): smtp://127.0.0.1:1025
# Üretim örneği: smtps://kullanici:parola@smtp.saglayici.com:465
SMTP_URL=
MAIL_FROM='"Türk Orbit" <no-reply@turkorbit.com>'

# Gerçek zamanlı oyun sunucusu (ayrı süreç: npm run dev:game). Redis zorunludur.
GAME_PORT=4001
# Bağlantısı kopan geminin haritada kalma süresi (sn); savaştan bağlantıyı keserek kaçmayı önler.
GAME_LINGER_SECONDS=30

# Aşama 13 — destek talebi ekleri. Web kökünün DIŞINDA bir klasör olmalı; dosyalar yalnızca yetkili uçtan indirilir.
# Boş bırakılırsa API'nin çalıştığı klasörde var/uploads kullanılır.
UPLOAD_DIR=
