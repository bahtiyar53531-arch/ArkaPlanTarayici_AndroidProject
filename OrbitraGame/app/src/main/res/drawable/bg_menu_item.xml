<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape><corners android:radius="12dp" /><solid android:color="#3319E3D6" /><stroke android:width="1dp" android:color="#AA19E3D6" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><corners android:radius="12dp" /><solid android:color="#442F7BFF" /></shape>
    </item>
    <item android:state_enabled="false">
        <shape><corners android:radius="12dp" /><solid android:color="#10FFFFFF" /></shape>
    </item>
    <item>
        <shape><corners android:radius="12dp" /><solid android:color="#1AFFFFFF" /></shape>
    </item>
</selector>
