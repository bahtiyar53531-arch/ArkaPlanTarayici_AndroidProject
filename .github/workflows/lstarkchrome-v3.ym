name: StarkChrome 8K Ultra v3 Derleyici
on: [push, workflow_dispatch]
permissions:
  contents: write
jobs:
  build-apk:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'
      - name: StarkChrome v3 Hazirla ve Derle
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          python3 -c '
          s = open(".github/workflows/starkorbit-v2.yml").read()
          b = s.split("mkdir -p app/src/main/java/org/arkaplan/tarayici", 1)[1].split("StarkChrome", 1)[0]
          lines = ["mkdir -p app/src/main/java/org/arkaplan/tarayici"] + [l[10:] if l.startswith("          ") else "" for l in b.splitlines() if "- name:" not in l]
          open("/tmp/setup_v2.sh", "w").write("\n".join(lines) + "\n")
          '
          bash /tmp/setup_v2.sh
          sed -n '/H4sIAAAAAAACA+1aS2/,/EOF/p' .github/workflows/starkorbit-v2.yml | grep -v "EOF" | tr -d ' \n\r' | base64 -di | gunzip | python3
          gradle assembleDebug --no-daemon
          cp app/build/outputs/apk/debug/app-debug.apk StarkChrome-8K-v3.apk
          cp app/build/outputs/apk/debug/app-debug.apk StarkOrbit-Tarayici-v2.apk
          cp app/build/outputs/apk/debug/app-debug.apk ArkaPlan-Tarayici.apk
          gh release delete v1.0 --yes || true
          gh release delete v2.0 --yes || true
          gh release delete v3.0 --yes || true
          git tag -d v3.0 || true
          gh release create v3.0 StarkChrome-8K-v3.apk StarkOrbit-Tarayici-v2.apk ArkaPlan-Tarayici.apk --title "StarkChrome 8K Ultra v3.0 (120 FPS + Chrome Arayuz + 8K Zoom + Bulut Kalkan)" --notes "StarkChrome 8K Ultra v3.0: 120Hz Maksimum FPS Motoru, 8K Ultra Cozunurluk (7680x4320) ve Yakinlastirma/Uzaklastirma (-/+), Tam Fonksiyonel Chrome Arayuzu ve Ayarlar Menusu, Boot/Kapanmama Bulut Arka Plan Kalkani."
